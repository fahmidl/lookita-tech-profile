---
const services = [
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
    title: 'Website & App Development',
    description: 'Kami membangun website modern, progressive web apps, dan mobile applications dengan teknologi terkini. Dari company profile hingga e-commerce dan SaaS platform.',
    features: ['React / Next.js', 'React Native / Flutter', 'E-Commerce', 'Custom Web Apps'],
    gradient: 'from-blue-500 to-cyan-500',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`,
    title: 'DevOps & Cloud Infrastructure',
    description: 'Optimasi deployment dan infrastruktur cloud Anda. Kami menangani CI/CD pipeline, containerization, cloud migration, dan monitoring untuk keandalan maksimal.',
    features: ['CI/CD Pipeline', 'Docker & Kubernetes', 'Cloud Migration', 'Monitoring & Logging'],
    gradient: 'from-purple-500 to-pink-500',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" /></svg>`,
    title: 'UI/UX Design',
    description: 'Desain yang tidak hanya indah tetapi juga fungsional. Kami menciptakan pengalaman pengguna yang intuitif melalui riset, wireframing, prototyping, dan visual design.',
    features: ['User Research', 'Wireframing', 'Prototyping', 'Design System'],
    gradient: 'from-amber-500 to-orange-500',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
    title: 'IT Consulting & Support',
    description: 'Konsultasi teknologi strategis untuk membantu bisnis Anda membuat keputusan IT yang tepat. Termasuk maintenance, technical audit, dan ongoing support.',
    features: ['Technical Audit', 'Tech Strategy', 'Maintenance', '24/7 Support'],
    gradient: 'from-green-500 to-emerald-500',
  },
];
---

<section id="services" class="py-24 relative">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-primary-950/5 to-transparent"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="text-primary-400 font-semibold text-sm uppercase tracking-wider">Our Services</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-white">
        Layanan Teknologi <span class="text-primary-400">Lengkap</span>
      </h2>
      <p class="mt-4 text-dark-300 max-w-2xl mx-auto">
        Kami menyediakan berbagai layanan teknologi untuk membantu bisnis Anda berkembang di era digital.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {services.map((service) => (
        <div class="group relative bg-dark-900/50 border border-white/5 rounded-2xl p-8 hover:border-primary-500/30 transition-all duration-300">
          <div class={`inline-flex items-center justify-center w-12 h-12 rounded-xl bg-gradient-to-br ${service.gradient} bg-opacity-10 text-white mb-5`} style={`background: linear-gradient(135deg, var(--tw-gradient-stops)); opacity: 0.15;`}>
          </div>
          <div class={`inline-flex items-center justify-center w-12 h-12 rounded-xl text-white mb-5 absolute top-8 left-8`} style={`background: linear-gradient(135deg, rgba(99,102,241,0.15), rgba(99,102,241,0.05));`}>
            <Fragment set:html={service.icon} />
          </div>

          <div class="ml-16">
            <h3 class="text-xl font-bold text-white group-hover:text-primary-300 transition-colors">
              {service.title}
            </h3>
          </div>

          <p class="mt-4 text-dark-300 text-sm leading-relaxed">
            {service.description}
          </p>

          <div class="mt-6 flex flex-wrap gap-2">
            {service.features.map((feature) => (
              <span class="px-3 py-1 bg-white/5 border border-white/5 rounded-full text-xs text-dark-300">
                {feature}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
