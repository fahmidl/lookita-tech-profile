---
---

<section id="contact" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative bg-gradient-to-br from-primary-900/30 to-dark-900 border border-white/5 rounded-3xl p-8 sm:p-12 lg:p-16 overflow-hidden">
      <!-- Background decoration -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-primary-500/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-48 h-48 bg-primary-600/10 rounded-full blur-3xl"></div>

      <div class="relative z-10 grid lg:grid-cols-2 gap-12">
        <!-- Left: CTA Content -->
        <div>
          <h2 class="text-3xl sm:text-4xl font-bold text-white">
            Siap Memulai Proyek
            <span class="text-primary-400">Digital Anda?</span>
          </h2>
          <p class="mt-4 text-dark-300 leading-relaxed">
            Hubungi kami untuk konsultasi gratis. Tim kami siap membantu mewujudkan ide Anda menjadi solusi digital yang berdampak.
          </p>

          <div class="mt-8 space-y-4">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-lg bg-primary-500/10 flex items-center justify-center text-primary-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <div class="text-sm text-dark-400">Email</div>
                <a href="mailto:hello@lookita.tech" class="text-white hover:text-primary-300 transition-colors">hello@lookita.tech</a>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-lg bg-primary-500/10 flex items-center justify-center text-primary-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <div class="text-sm text-dark-400">Location</div>
                <span class="text-white">Indonesia</span>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-lg bg-primary-500/10 flex items-center justify-center text-primary-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <div class="text-sm text-dark-400">Response Time</div>
                <span class="text-white">&lt; 24 hours</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Contact Form -->
        <div>
          <form class="space-y-5" action="#" method="POST">
            <div>
              <label for="name" class="block text-sm font-medium text-dark-300 mb-1.5">Nama</label>
              <input
                type="text"
                id="name"
                name="name"
                class="w-full px-4 py-3 bg-dark-900/80 border border-white/10 rounded-xl text-white placeholder-dark-500 focus:outline-none focus:border-primary-500/50 focus:ring-1 focus:ring-primary-500/25 transition-all"
                placeholder="Nama lengkap Anda"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-dark-300 mb-1.5">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                class="w-full px-4 py-3 bg-dark-900/80 border border-white/10 rounded-xl text-white placeholder-dark-500 focus:outline-none focus:border-primary-500/50 focus:ring-1 focus:ring-primary-500/25 transition-all"
                placeholder="email@example.com"
              />
            </div>
            <div>
              <label for="service" class="block text-sm font-medium text-dark-300 mb-1.5">Layanan yang Diminati</label>
              <select
                id="service"
                name="service"
                class="w-full px-4 py-3 bg-dark-900/80 border border-white/10 rounded-xl text-white focus:outline-none focus:border-primary-500/50 focus:ring-1 focus:ring-primary-500/25 transition-all"
              >
                <option value="" class="bg-dark-900">Pilih layanan</option>
                <option value="web-app" class="bg-dark-900">Website & App Development</option>
                <option value="devops" class="bg-dark-900">DevOps & Cloud Infrastructure</option>
                <option value="design" class="bg-dark-900">UI/UX Design</option>
                <option value="consulting" class="bg-dark-900">IT Consulting & Support</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-dark-300 mb-1.5">Pesan</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                class="w-full px-4 py-3 bg-dark-900/80 border border-white/10 rounded-xl text-white placeholder-dark-500 focus:outline-none focus:border-primary-500/50 focus:ring-1 focus:ring-primary-500/25 transition-all resize-none"
                placeholder="Ceritakan tentang proyek Anda..."
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full px-6 py-3.5 bg-primary-600 hover:bg-primary-500 text-white font-semibold rounded-xl transition-all duration-200 shadow-lg shadow-primary-600/25 hover:shadow-primary-500/40"
            >
              Kirim Pesan
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
